const express = require('express');
const cors = require('cors');
const axios = require('axios');

const app = express();
app.use(cors());

const PORT = process.env.PORT || 3000;
const DEFAULT_REFERER = 'https://aryzap.com/';

// 🔐 Cryptic random codes (koi guess nahi kar sakta)
const CHANNELS = {
    'k7x9p2m': 'https://arynews.aryzap.com/2db6f0bbb29bb8b4d3b89f8e971340fe/6ac2d257/v1/0183ea205add0b8ed5941a38bc6f/0183ea20909b0b8ed5aa4d793456/main.m3u8',
    'q3n8z1v': 'https://aryqtv.aryzap.com/e3ccc0657d47d20f79ba6213012ee365/6ac2aff7/v1/0183ea2a0eec0b8ed5941a38bc76/0183ea2a4e470b8ed5aa4d793457/main.m3u8',
    'w5r2y9t': 'https://arymusik.aryzap.com/91ef42c72950d1316e4a69d46ef2196a/6ac2ce6c/v1/01847ac7a4930b8ed5aa6ed04aba/01847ac8f5f70b8ed5aa6ed04abd/main.m3u8',
    'a8f4h6j': 'https://arydigital.aryzap.com/3de404f9981f0dea7666778c1c5cf6ad/6ac2d33c/v1/0183ea2408f90b8ed5941a38bc72/0183ea24302d0b8ed5941a38bc75/main.m3u8',
    'b2c7d9e': 'https://aryzindagi.aryzap.com/c682553867cbb3520baf18a7e5e87d68/6ac2d419/v1/01847acaa0f70b8ed5aa6ed04abe/01847acacfc30b8ed5aa6ed04ac1/main.m3u8'
};

app.get('/', (req, res) => {
    res.json({ status: 'ok', message: 'ARY Proxy is running' });
});

// 🔐 Short route WITH .m3u8 extension: /b2c7d9e.m3u8
app.get('/:code', async (req, res, next) => {
    // Code se .m3u8 extension hata dein
    const code = req.params.code.replace(/\.m3u8$/i, '');
    const channelUrl = CHANNELS[code];
    
    if (!channelUrl) return next();

    try {
        const response = await axios.get(channelUrl, {
            headers: {
                'Referer': DEFAULT_REFERER,
                'Origin': 'https://aryzap.com',
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
                'Accept': '*/*'
            },
            responseType: 'arraybuffer',
            timeout: 30000,
            maxRedirects: 5
        });

        const contentType = response.headers['content-type'] || 'application/vnd.apple.mpegurl';
        res.set('Content-Type', contentType);
        res.set('Access-Control-Allow-Origin', '*');

        let text = Buffer.from(response.data).toString('utf-8');
        const baseUrl = channelUrl.substring(0, channelUrl.lastIndexOf('/') + 1);
        const proxyBase = `${req.protocol}://${req.get('host')}/proxy`;

        text = text.split('\n').map(line => {
            const trimmed = line.trim();
            if (trimmed && !trimmed.startsWith('#')) {
                const fullUrl = trimmed.startsWith('http') ? trimmed : baseUrl + trimmed;
                return `${proxyBase}?url=${encodeURIComponent(fullUrl)}&referer=${encodeURIComponent(DEFAULT_REFERER)}`;
            }
            return line.replace(/URI="([^"]+)"/g, (match, uri) => {
                const fullUrl = uri.startsWith('http') ? uri : baseUrl + uri;
                return `URI="${proxyBase}?url=${encodeURIComponent(fullUrl)}&referer=${encodeURIComponent(DEFAULT_REFERER)}"`;
            });
        }).join('\n');

        res.send(text);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Generic proxy route
app.get('/proxy', async (req, res) => {
    const targetUrl = req.query.url;
    const referer = req.query.referer || DEFAULT_REFERER;

    if (!targetUrl) {
        return res.status(400).json({ error: 'url parameter required' });
    }

    try {
        const response = await axios.get(targetUrl, {
            headers: {
                'Referer': referer,
                'Origin': new URL(referer).origin,
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
                'Accept': '*/*'
            },
            responseType: 'arraybuffer',
            timeout: 30000,
            maxRedirects: 5
        });

        const contentType = response.headers['content-type'] || 'application/octet-stream';
        res.set('Content-Type', contentType);
        res.set('Access-Control-Allow-Origin', '*');

        let data = response.data;

        if (targetUrl.includes('.m3u8') || contentType.includes('mpegurl')) {
            let text = Buffer.from(data).toString('utf-8');
            const baseUrl = targetUrl.substring(0, targetUrl.lastIndexOf('/') + 1);
            const proxyBase = `${req.protocol}://${req.get('host')}/proxy`;

            text = text.split('\n').map(line => {
                const trimmed = line.trim();
                if (trimmed && !trimmed.startsWith('#')) {
                    const fullUrl = trimmed.startsWith('http') ? trimmed : baseUrl + trimmed;
                    return `${proxyBase}?url=${encodeURIComponent(fullUrl)}&referer=${encodeURIComponent(referer)}`;
                }
                return line.replace(/URI="([^"]+)"/g, (match, uri) => {
                    const fullUrl = uri.startsWith('http') ? uri : baseUrl + uri;
                    return `URI="${proxyBase}?url=${encodeURIComponent(fullUrl)}&referer=${encodeURIComponent(referer)}"`;
                });
            }).join('\n');

            return res.send(text);
        }

        res.send(data);
    } catch (err) {
        console.error('Proxy error:', err.message);
        res.status(500).json({ error: err.message });
    }
});

app.listen(PORT, () => {
    console.log(`✅ ARY Proxy running on port ${PORT}`);
});
